{
  "name": "windsurf-skills",
  "version": "1.0.0",
  "description": "Windsurf skills repository",
  "type": "module",
  "scripts": {
    "prepare": "bunx taze -r -w -i",
    "dev": "bun --watch scripts/generate-skill.ts",
    "build": "bun run scripts/generate-workflows.ts",
    "check": "tsc --noEmit && biome lint --write",
    "format": "biome format --write"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@types/bun": "^1.3.11",
    "@types/node": "^25.5.0",
    "cac": "^7.0.0",
    "oxlint": "^1.56.0",
    "typescript": "^5.9.3"
  }
}
