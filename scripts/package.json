{
	"name": "windsurf-skills",
	"version": "1.0.0",
	"description": "Windsurf skills repository",
	"type": "module",
	"scripts": {
		"prepare": "bunx taze -r -w -i",
		"dev": "bun --watch index.ts",
		"check": "tsc --noEmit && biome lint --write",
		"format": "biome format --write",
		"test": "bun test",
		"build": "bun build src/index.ts --outdir dist --target bun",
		"build:clean": "bun build src/index.ts --outdir dist --target bun --minify",
		"start": "bun dist/index.js"
	},
	"dependencies": {
		"cac": "^7.0.0",
		"chalk": "^5.6.2",
		"effect": "^3.20.0",
		"execa": "^9.6.1",
		"fs-extra": "^11.3.4",
		"glob": "^13.0.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.8",
		"@types/bun": "^1.3.11",
		"@types/fs-extra": "^11.0.4",
		"@types/node": "^25.5.0",
		"bun-types": "1.3.11",
		"oxlint": "^1.56.0",
		"typescript": "^5.9.3"
	}
}
